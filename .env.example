# Copy to .env (repo root or engine/). See the Configuration table in README.md.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# staged-lite (default), staged, or single
STRATEGY=staged-lite
# true = canned recipe, no API key needed
DEMO_MODE=false
MAX_AUDIO_MB=50

# API server
DATA_DIR=./data
# Postgres for saved recipes; empty = JSON files in DATA_DIR
DATABASE_URL=
# Leave empty so share links use the request's own host
PUBLIC_BASE_URL=

# Where `rcpy parse --share` publishes recipes
SHARE_URL=https://rcpy.vercel.app
