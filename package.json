{
  "name": "crumbly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Turn dictated recipes into Crouton-ready links, QR codes, and .crumb files.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c green,magenta \"node --watch --env-file-if-exists=.env server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@google/genai": "^2.13.0",
    "express": "^5.2.1",
    "lucide-react": "^1.26.0",
    "multer": "^2.2.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.1",
    "supertest": "^7.1.4",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
