{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/server.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/server?__rcpy_path=/api/:path*"
    },
    {
      "source": "/health",
      "destination": "/api/server?__rcpy_path=/health"
    },
    {
      "source": "/r/:slug",
      "destination": "/api/server?__rcpy_path=/r/:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
