{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd web && npm ci",
  "buildCommand": "cd web && npm run build:vercel",
  "outputDirectory": "web/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "engine/src/rcpy/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?__rcpy_path=/api/:path*"
    },
    {
      "source": "/r/:slug",
      "destination": "/api/index?__rcpy_path=/r/:slug"
    },
    {
      "source": "/health",
      "destination": "/api/index?__rcpy_path=/health"
    },
    {
      "source": "/how-it-works",
      "destination": "/index.html"
    }
  ]
}
